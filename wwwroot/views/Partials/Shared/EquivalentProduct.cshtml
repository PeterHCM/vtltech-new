@inherits UmbracoViewPage<IPublishedContent>
@using Umbraco.Extensions

@{
    var equivalentProducts = Model.Parent?.Children()
                                .Where(x => x.Id != Model.Id && x.IsVisible())
                                .Take(12).ToList() ?? new List<IPublishedContent>();
    var productdetail = Umbraco.GetDictionaryValue("viewMoreText") ?? "Chi tiết sản phẩm";
    var currentDomain = Context.Request.Host.Value;
    var currentCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "vi-VN";
    var isVietnamese = currentCulture == "vi-VN";
    var isIntranet = currentDomain.Contains("intranet");
}
@if (equivalentProducts.Any())
{
    <section class="py-12 border-t border-gray-100 dark:border-white/5 bg-white dark:bg-transparent"
             x-data="{ 
                atBeginning: true,
                atEnd: false,
                next() {
                    this.$refs.slider.scrollBy({ left: 320, behavior: 'smooth' });
                },
                prev() {
                    this.$refs.slider.scrollBy({ left: -320, behavior: 'smooth' });
                },
                check() {
                    const el = this.$refs.slider;
                    this.atBeginning = el.scrollLeft <= 10;
                    this.atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 10;
                }
             }" x-init="setTimeout(() => check(), 100)">
        <div class="vtl-container px-4">
            
            <div class="flex items-end justify-between mb-8">
                <div class="space-y-2">
                    <h2 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white uppercase tracking-tighter">
                        @(isVietnamese ? "Sản phẩm" : "Related")
                        <span class="bg-gradient-to-r from-[#e06800] to-[#ff9f40] bg-clip-text text-transparent">
                            @(isVietnamese ? " tương đương" : " Product")
                        </span>
                    </h2>
                    <div class="h-1.5 w-20 bg-[#006361] rounded-full"></div>
                </div>

                @if (equivalentProducts.Count > 1)
                {
                    <div class="flex gap-2">
                        <button @click="prev" 
                                :disabled="atBeginning"
                                :class="atBeginning ? 'opacity-20 cursor-not-allowed' : 'hover:bg-[#e06800] hover:text-white hover:scale-105 active:scale-95'"
                                class="w-10 h-10 rounded-lg border border-gray-200 dark:border-white/10 flex items-center justify-center transition-all duration-300 text-gray-500 bg-white dark:bg-gray-800 shadow-sm">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                        </button>
                        <button @click="next" 
                                :disabled="atEnd"
                                :class="atEnd ? 'opacity-20 cursor-not-allowed' : 'hover:bg-[#e06800] hover:text-white hover:scale-105 active:scale-95'"
                                class="w-10 h-10 rounded-lg border border-gray-200 dark:border-white/10 flex items-center justify-center transition-all duration-300 text-gray-500 bg-white dark:bg-gray-800 shadow-sm">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </button>
                    </div>
                }
            </div>

            <div class="relative group">
                <div x-ref="slider"
                     @scroll.debounce.50ms="check()"
                     class="flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory no-scrollbar pb-6">
                    
                    @foreach (var item in equivalentProducts)
                    {
                        var images = item.Value<IEnumerable<Umbraco.Cms.Core.Models.MediaWithCrops>>("image");
                        var firstImage = images?.FirstOrDefault();
                        // Tối ưu hóa: Crop ảnh theo tỷ lệ 16:9 ngay từ server nếu có thể
                        var productImg = firstImage?.GetCropUrl(width: 640, height: 360) ?? firstImage?.Url();

                        <div class="snap-start shrink-0 w-[75%] sm:w-[45%] md:w-[31%] lg:w-[24%]">
                            <a href="@item.Url()" 
                               class="group block h-full rounded-xl bg-white dark:bg-[#0d0d0e] overflow-hidden border border-gray-100 dark:border-white/5 hover:border-[#e06800]/40 transition-all duration-500 hover:shadow-xl">
                                
                                <div class="relative aspect-[16/9] overflow-hidden bg-gray-50 dark:bg-gray-800">
                                    <img src="@productImg" 
                                         alt="@item.Name" 
                                         loading="lazy"
                                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                </div>

                                <div class="p-4">
                                    <h3 class="text-sm font-bold text-gray-800 dark:text-gray-200 group-hover:text-[#e06800] transition-colors line-clamp-2 h-10 mb-2">
                                        @item.Name
                                    </h3>
                                    <div class="flex items-center justify-between mt-4">
                                        <span class="text-[10px] font-black uppercase text-[#006361] tracking-widest">
                                            @productdetail
                                        </span>
                                        <div class="text-[#e06800] transform translate-x-[-8px] opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}