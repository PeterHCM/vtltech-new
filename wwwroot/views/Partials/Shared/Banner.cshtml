@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Extensions

@{
    var currentPage = Model;
    var title = currentPage.Name;
    var description = currentPage.Value<string>("pageDescription");
    var ancestors = currentPage.Ancestors().Where(x => x.Level > 1).OrderBy(x => x.Level).ToList();
    var currentDomain = Context.Request.Host.Value;
    var currentCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "vi-VN";
    var isVietnamese = currentCulture == "vi-VN";
    var isIntranet = currentDomain.Contains("intranet");
    var image = currentPage.Value<IEnumerable<IPublishedContent>>("image")?.FirstOrDefault()?.Url();
    var imageUrl = image ?? "/media/wmld4zgl/vtl_eaton_mtl.png";
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isMinimalPage = path.Contains("/su-kien") || path.Contains("/events") || path.Contains("/landing");
}

@if (!isIntranet && !isMinimalPage)
{
    <section class="relative min-h-[250px] md:min-h-[250px] flex items-center bg-gray-950 overflow-hidden">
        @* Background Layer *@
        <div class="absolute inset-0 select-none">
            <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent z-10"></div>
            <img src="@imageUrl" alt="Banner @title" class="w-full h-full object-cover object-center scale-105" loading="lazy" />
            <div class="absolute inset-0 opacity-[0.05] z-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:40px_40px]"></div>
        </div>

        @* Main Content (Title & Description) *@
        <div class="relative z-20 vtl-container px-4">
            <div class="max-w-5xl">
                <div class="hidden md:block flex items-center gap-4 mb-2">
                    <div class="h-[2px] w-8 bg-[#006361]"></div>
                    <span class="text-[10px] font-black text-[#006361] tracking-[0.3em] uppercase">Solution Provider For Industries</span>
                </div>
                
                <h1 class="hidden md:block text-3xl md:text-4xl lg:text-5xl font-black text-white leading-[1.1] uppercase tracking-tighter">
                    @title<span class="text-[#e06800]">.</span>
                </h1>

                @if (!string.IsNullOrWhiteSpace(description))
                {
                    <p class="mt-4 text-sm md:text-base text-gray-300 leading-relaxed max-w-2xl font-medium border-l-2 border-[#e06800]/30 pl-4">
                        @description
                    </p>
                }
            </div>
        </div>

        @* Breadcrumb: Đẩy xuống sát mép dưới *@
        <div class="absolute bottom-0 left-0 w-full z-30 bg-black/20 backdrop-blur-sm border-t border-white/5">
            <div class="vtl-container px-4 py-3">
                <nav aria-label="Breadcrumb">
                    <ol class="flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.2em] font-bold">
                        <li>
                            <a href="/" class="text-white/50 hover:text-[#e06800] transition-colors duration-300 italic">
                                @(isVietnamese ? "Trang chủ" : "Home")
                            </a>
                        </li>
                        @foreach (var ancestor in ancestors)
                        {
                            <li class="flex items-center gap-2">
                                <span class="text-white/20">/</span>
                                <a href="@ancestor.Url()" class="text-white/50 hover:text-[#e06800] transition-colors italic">@ancestor.Name</a>
                            </li>
                        }
                        <li class="flex items-center gap-2">
                            <span class="text-white/20">/</span>
                            <span class="text-[#e06800]" aria-current="page">@title</span>
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </section>
}
else if (!isMinimalPage)
{    
@* =======================
   INTRANET HEADER
   Clean • Enterprise • No Branding Color
   ======================= *@
<div class="bg-white dark:bg-gray-950 border-b border-gray-100 dark:border-gray-800">
    <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-24 py-8">

        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="flex flex-wrap items-center gap-1 text-xs font-semibold tracking-wide">

                <!-- Home -->
                <li>
                    <a href="/"
                       class="px-2 py-1 rounded
                              text-gray-500 dark:text-gray-400
                              hover:text-gray-900 dark:hover:text-white
                              hover:bg-gray-100 dark:hover:bg-white/10
                              transition-colors">
                        @(isVietnamese ? "Trang chủ" : "Home")
                    </a>
                </li>

                @foreach (var ancestor in ancestors)
                {
                    <li class="flex items-center gap-1">
                        <span class="text-gray-300 dark:text-gray-700">›</span>
                        <a href="@ancestor.Url()"
                           class="px-2 py-1 rounded
                                  text-gray-500 dark:text-gray-400
                                  hover:text-gray-900 dark:hover:text-white
                                  hover:bg-gray-100 dark:hover:bg-white/10
                                  transition-colors">
                            @ancestor.Name
                        </a>
                    </li>
                }

                <!-- Current -->
                <li class="flex items-center gap-1">
                    <span class="text-gray-300 dark:text-gray-700">›</span>
                    <span class="px-2 py-1 rounded
                                 text-gray-900 dark:text-white
                                 font-bold
                                 bg-gray-100 dark:bg-white/10">
                        @title
                    </span>
                </li>
            </ol>
        </nav>

        <!-- Title -->
        <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight
                   text-gray-900 dark:text-white">
            @title
        </h1>

        <!-- Description -->
        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="mt-3 max-w-3xl text-sm md:text-base
                      text-gray-500 dark:text-gray-400
                      border-l-4 border-gray-300 dark:border-gray-700
                      pl-4 italic">
                @description
            </p>
        }
    </div>
</div>
}