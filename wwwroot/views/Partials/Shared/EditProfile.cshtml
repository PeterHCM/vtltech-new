@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Website.Controllers
@using Umbraco.Cms.Web.Website.Models
@using Umbraco.Extensions
@using System.Linq
@using System.Text.Json
@using System.Globalization
@using Umbraco.Cms.Core.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject MemberModelBuilderFactory MemberModelBuilderFactory
@inject IDataTypeService DataTypeService
@inject IMemberTypeService MemberTypeService

@{
    // 1. Khởi tạo dữ liệu Profile
    var profileModel = await MemberModelBuilderFactory
        .CreateProfileModel()
        .WithRedirectUrl(null)
        .WithCustomProperties(true)
        .BuildForCurrentMemberAsync();

    var hasUpdateSuccess = TempData["FormSuccess"] != null;

    // 2. Định nghĩa hằng số Tab
    const string TabAccount = "account";
    const string TabPersonal = "personal";
    const string TabWork = "work";
    const string TabEmergency1 = "emergency1";
    const string TabEmergency2 = "emergency2";

    // 3. Xử lý Logic URL & Query String
    var activeQueryParameters = Context.Request.Query
        .Where(q => !q.Key.Equals("tab", StringComparison.OrdinalIgnoreCase))
        .ToList();
    
    string baseQueryString = string.Join("&", activeQueryParameters.Select(kv => $"{kv.Key}={kv.Value}"));

    string BuildTabUrl(string tabName)
    {
        string separator = string.IsNullOrEmpty(baseQueryString) ? "?" : "&";
        return $"{Context.Request.Path}?{baseQueryString}{separator}tab={tabName}";
    }

    var currentActiveTab = Context.Request.Query["tab"].ToString().ToLower();
    if (string.IsNullOrWhiteSpace(currentActiveTab)) currentActiveTab = TabAccount;

    // 4. Helpers cho Giao diện
    string GetTabCssClass(string tabName) =>
        tabName.Equals(currentActiveTab, StringComparison.OrdinalIgnoreCase)
        ? "flex items-center gap-2 px-4 py-2 font-semibold text-white bg-primary rounded"
        : "flex items-center gap-2 px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-primary";

    const string StandardInputCssClass = "block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-primary focus:border-primary";

    // 5. Cấu hình các trường dữ liệu (Field Mappings)
    var datePropertyAliases = new[] { "dateofbirth", "dateofissue", "dateofjoining" };
    
    var tabToFieldsMap = new Dictionary<string, string[]>
    {
        { TabAccount, new[] { "Hello" } },
        { TabPersonal, new[] { 
            "fullname", "phone", "personalemail", "gender", "maritalstatus", "dateofbirth", "nationalid", "dateofissue", "placeofissue", "taxcode", "permanentaddress", "currentaddress"
        } },
        { TabWork, new[] { 
            "position", "department", "dateofjoining", "contracttype" 
        } },
    };

    // 6. Lấy dữ liệu Dropdown từ Umbraco Data Types
    var maritalStatusDataType = await DataTypeService.GetAsync(Guid.Parse("f9e5b2d5-110c-4c14-8c1f-f7e5baecfa46"));
    var contractTypeDataType = await DataTypeService.GetAsync(Guid.Parse("e23c2f83-7a82-4e71-914f-637d86ac69d0"));
    var positionDataType = await DataTypeService.GetAsync(Guid.Parse("1e8931bc-2b27-447a-8a51-d65b475bfdcf"));
    var departmentDataType = await DataTypeService.GetAsync(Guid.Parse("e543ef9e-9f68-4689-9ed0-2216c4e45ead"));
    var relationshipDataType = await DataTypeService.GetAsync(Guid.Parse("9d8451a8-4aa3-4082-897b-c57e981be393"));

    List<string> ParseDropdownOptions(IDataType? dataType)
    {
        if (dataType is DataType dt && dt.ConfigurationData is Dictionary<string, object> config && config.TryGetValue("items", out var items))
        {
            var json = JsonSerializer.Serialize(items);
            return JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
        }
        return new List<string>();
    }

    var dropdownOptionsMap = new Dictionary<string, List<string>>
    {
        { "maritalstatus", ParseDropdownOptions(maritalStatusDataType) },
        { "contracttype", ParseDropdownOptions(contractTypeDataType) },
        { "position", ParseDropdownOptions(positionDataType) },
        { "department", ParseDropdownOptions(departmentDataType) },
        { "emergencycontact1relationship", ParseDropdownOptions(relationshipDataType) },
        { "emergencycontact2relationship", ParseDropdownOptions(relationshipDataType) }
    };
}

@if (profileModel != null)
{
    <div class="max-w-3xl mx-auto p-6 bg-white dark:bg-gray-900 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Cập nhật tài khoản</h2>
        
        @if (hasUpdateSuccess)
        {
            <div class="mb-4 text-green-600 dark:text-green-400 text-sm">
                ✅ Cập nhật tài khoản thành công!
            </div>
        }
        
        @* Navigation Tabs *@
        <div class="mb-6 flex gap-4 flex-wrap">
            <a href="@BuildTabUrl(TabAccount)" class="@GetTabCssClass(TabAccount)">Tài khoản</a>
            <a href="@BuildTabUrl(TabPersonal)" class="@GetTabCssClass(TabPersonal)">Cá nhân</a>
            <a href="@BuildTabUrl(TabWork)" class="@GetTabCssClass(TabWork)">Công việc</a>
            <a href="@BuildTabUrl(TabEmergency1)" class="@GetTabCssClass(TabEmergency1)">Liên hệ 1</a>
            <a href="@BuildTabUrl(TabEmergency2)" class="@GetTabCssClass(TabEmergency2)">Liên hệ 2</a>
        </div>
        
        @using (Html.BeginUmbracoForm<UmbProfileController>("HandleUpdateProfile", new { RedirectUrl = Context.Request.Path + Context.Request.QueryString }))
        {
            <div asp-validation-summary="All" class="text-sm text-red-600 dark:text-red-400 mb-4"></div>
            
            @* Account Tab Fields *@
            <div class="@(currentActiveTab != TabAccount ? "hidden" : "block")">
                <div class="mb-4">
                    <label asp-for="@profileModel.Name" class="block font-medium mb-1 text-gray-700 dark:text-gray-300">Tên</label>
                    <input asp-for="@profileModel.Name" name="Name" class="@StandardInputCssClass" readonly />
                </div>
                <div class="mb-4">
                    <label asp-for="@profileModel.Email" class="block font-medium mb-1 text-gray-700 dark:text-gray-300">Email hệ thống</label>
                    <input asp-for="@profileModel.Email" class="@StandardInputCssClass" readonly/>
                </div>
                <div class="mb-4">
                    <label asp-for="@profileModel.UserName" class="block font-medium mb-1 text-gray-700 dark:text-gray-300">Tên đăng nhập</label>
                    <input asp-for="@profileModel.UserName" class="@StandardInputCssClass" />
                </div>
            </div>

            @* Dynamic Properties *@
            @for (int i = 0; i < profileModel.MemberProperties.Count; i++)
            {
                var memberProp = profileModel.MemberProperties[i];
                var alias = memberProp.Alias.ToLower();                                            
                
                var isVisibleInCurrentTab = 
                    (tabToFieldsMap.ContainsKey(currentActiveTab) && tabToFieldsMap[currentActiveTab].Contains(alias)) ||
                    (currentActiveTab == TabEmergency1 && alias.StartsWith("emergencycontact1")) ||
                    (currentActiveTab == TabEmergency2 && alias.StartsWith("emergencycontact2"));

                if (!isVisibleInCurrentTab)
                {
                    <input type="hidden" name="profileModel.MemberProperties[@i].Alias" value="@memberProp.Alias" />
                    <input type="hidden" name="profileModel.MemberProperties[@i].Value" value="@memberProp.Value" />
                    continue;
                }

                <div class="mb-4">
                    <label class="block font-medium mb-1 text-gray-700 dark:text-gray-300">@memberProp.Name</label>
                    <input type="hidden" name="profileModel.MemberProperties[@i].Alias" value="@memberProp.Alias" />

                    @if (dropdownOptionsMap.ContainsKey(alias))
                    {
                        var rawValue = memberProp.Value?.ToString() ?? string.Empty;
                        string? selectedValue = rawValue.StartsWith("[") 
                            ? JsonSerializer.Deserialize<string[]>(rawValue)?.FirstOrDefault() 
                            : rawValue;

                        <select name="profileModel.MemberProperties[@i].Value" class="@StandardInputCssClass">
                            @foreach (var option in dropdownOptionsMap[alias])
                            {
                                <option value="@option" selected="@(option == selectedValue ? "selected" : null)">@option</option>
                            }
                        </select>
                    }
                    else if (datePropertyAliases.Contains(alias))
                    {
                        var rawValue = memberProp.Value?.ToString();
                        string formattedDate = "";

                        if (DateTime.TryParseExact(rawValue, "dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime parsedDate))
                        {
                            formattedDate = parsedDate.ToString("yyyy-MM-dd");
                        }

                        <input type="date" name="profileModel.MemberProperties[@i].Value" value="@formattedDate" class="@StandardInputCssClass" />
                    }
                    else
                    {
                        <input type="text" name="profileModel.MemberProperties[@i].Value" value="@memberProp.Value" id="@memberProp.Alias" class="@StandardInputCssClass" />
                    }
                </div>
            }

            <button type="submit" class="w-full bg-primary hover:bg-secondary text-white font-medium py-2 px-4 rounded transition duration-200 mt-4">
                Lưu thay đổi
            </button>
        }
    </div>
}
