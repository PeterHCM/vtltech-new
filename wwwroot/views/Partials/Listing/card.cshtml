@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Services
@using System.Text.Json
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@inject IMemberService MemberService

@functions {
    // Helper xử lý chữ không dấu
    public string ToAscii(string input) {
        if (string.IsNullOrEmpty(input)) return "";
        var normalized = input.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder();
        foreach (char c in normalized) {
            if (Char.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark) sb.Append(c);
        }
        return Regex.Replace(sb.ToString(), "[đĐ]", m => m.Value == "đ" ? "d" : "D").Normalize(NormalizationForm.FormC);
    }
}

@{
    // 1. LẤY SETTINGS CÔNG TY
    var settings = Umbraco.ContentAtRoot()?.FirstOrDefault(x => x.ContentType.Alias == "companySettings");
    if (settings == null) return;

    var compName = settings.Value<string>("companyName") ?? "VTL Technology";
    var compAddr = settings.Value<string>("companyAddress") ?? "";
    var compTel = settings.Value<string>("companyNumber") ?? "";
    var compFax = settings.Value<string>("companyFax") ?? "";

    // 2. LẤY THÔNG TIN MEMBER
    var targetUser = Context.Request.Query["user"].ToString();
    if (string.IsNullOrWhiteSpace(targetUser)) { <p>Missing user</p>; return; }

    var member = MemberService.GetByUsername(targetUser);
    if (member == null) { <p>User not found</p>; return; }

    var fullName = member.GetValue<string>("fullName") ?? "";
    var email = member.Email ?? "";
    var mobile = member.GetValue<string>("phone") ?? "";
    var website = "https://vtltech.com.vn";
    
    var rawPos = member.GetValue<string>("position");
    var position = rawPos?.StartsWith("[") == true 
        ? JsonSerializer.Deserialize<List<string>>(rawPos)?.FirstOrDefault() 
        : rawPos;

    // 3. XỬ LÝ AVATAR
    var avatarUrl = "https://placehold.co/300x300/111827/ffffff?text=VTL";
    var photoJson = member.GetValue<string>("photo");
    if (!string.IsNullOrEmpty(photoJson) && photoJson.StartsWith("[")) {
        try {
            using var doc = JsonDocument.Parse(photoJson);
            var mediaKey = doc.RootElement[0].GetProperty("mediaKey").GetGuid();
            avatarUrl = Umbraco.Media(mediaKey)?.Url() ?? avatarUrl;
        } catch {}
    }

    // 4. TẠO VCARD CONTENT (SERVER-SIDE)
    var cleanName = ToAscii(fullName);
    var nameParts = cleanName.Trim().Split(' ');
    string lastName = nameParts.Last();
    string firstName = string.Join(" ", nameParts.Take(nameParts.Length - 1));

    var vCardContent = $"BEGIN:VCARD\nVERSION:3.0\nN:{lastName};{firstName};;;\nFN:{cleanName}\nORG:{ToAscii(compName)}\nTITLE:{ToAscii(position)}\nTEL;TYPE=CELL:{mobile.Replace(" ", "")}\nTEL;TYPE=WORK:{compTel.Replace(" ", "")}\nEMAIL:{email}\nURL:{website}\nADR;TYPE=WORK:;;{ToAscii(compAddr)};;;;Vietnam\nEND:VCARD";
    var fileNameVcf = cleanName.Replace(" ", "_") + ".vcf";
}

@* GIỮ NGUYÊN HOÀN TOÀN HTML CỦA BẠN *@
<div class="group relative bg-white dark:bg-gray-900 rounded-[3rem] shadow-2xl border border-gray-100 dark:border-gray-800 overflow-hidden max-w-4xl mx-auto">
    <div class="p-8 md:p-12">
        <div class="flex flex-col lg:flex-row gap-12">
            <div class="lg:w-1/3 flex flex-col items-center lg:items-start">
                <div class="relative mb-8">
                    <div class="absolute -inset-2 bg-gradient-to-tr from-vtl-orange to-vtl-teal rounded-[2.5rem] opacity-20 group-hover:opacity-40 transition-opacity"></div>
                    <img src="@avatarUrl" class="relative w-40 h-40 rounded-[2.2rem] object-cover bg-white p-1 shadow-lg" />
                </div>
                <div class="text-center lg:text-left">
                    <h3 class="text-2xl ">@fullName</h3>
                    <div class="mt-2 inline-block px-4 py-1.5 bg-vtl-orange/10 text-vtl-orange text-[11px] font-black uppercase tracking-widest rounded-full">
                        @position
                    </div>
                </div>
                <div class="mt-8 w-full space-y-4">
                    <a href="tel:@mobile" class="group/link flex items-center gap-4 text-slate-600 dark:text-slate-300 hover:text-primary transition-all">
                        <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 group-hover/link:bg-vtl-teal group-hover/link:text-primary transition-all shadow-sm">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M2.25 6.75c0 7.456 6.044 13.5 13.5 13.5h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 00-1.173.417l-.97 1.293a.75.75 0 01-.976.224 11.25 11.25 0 01-6.75-6.75.75.75 0 01.224-.976l1.293-.97c.363-.272.522-.739.417-1.173L6.463 3.102A1.125 1.125 0 005.372 2.25H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                        </div>
                        <span class="text-sm font-bold">@mobile</span>
                    </a>
                    <a href="mailto:@email" class="group/link flex items-center gap-4 text-slate-600 dark:text-slate-300 hover:text-primary transition-all">
                        <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 group-hover/link:bg-vtl-teal group-hover/link:text-primary transition-all shadow-sm">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15A2.25 2.25 0 002.25 6.75m19.5 0l-8.69 5.52a1.5 1.5 0 01-1.62 0L2.25 6.75" /></svg>
                        </div>
                        <span class="text-sm font-bold truncate">@email</span>
                    </a>
                </div> 
            </div>

            <div class="lg:w-2/3 flex flex-col justify-between space-y-10">
                <div class="relative p-6 rounded-[2.5rem] tracking-wider bg-gradient-to-r from-vtl-orange to-vtl-teal border border-gray-100 dark:border-gray-800 shadow-inner">
                    <div class="pl-6">
                        <h4 class="text-lg font-black text-gray-800 dark:text-gray-100 uppercase tracking-tight">@compName</h4>
                        <p class="mt-2 text-[11px] font-bold text-gray-400 leading-relaxed">@compAddr</p>
                        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[10px] font-black text-vtl-teal/80 uppercase">
                            <span class="flex items-center gap-1.5">Tel:&nbsp;<b class="text-gray-700 dark:text-gray-300">@compTel</b></span>
                            <span class="inline md:inline opacity-30">|</span>
                            <span class="flex items-center gap-1.5">Fax:&nbsp;<b class="text-gray-700 dark:text-gray-300">@compFax</b></span>
                        </div>
                    </div>
                </div>

                <div class="space-y-6 mt-6">
                    <h4 class="text-[10px] font-black uppercase tracking-[0.3em] text-vtl-orange flex items-center gap-3">
                        <span class="w-8 h-0.5 bg-vtl-orange"></span> @Umbraco.GetDictionaryValue("VCard.ScanMe")
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                        <div class="flex flex-col items-center gap-3">
                            <div class="relative group border border-gray-200 rounded-2xl shadow-inner transition-all hover:border-vtl-teal/50">
                                <div id="qr-vcard" class="w-48 h-48 flex items-center justify-center"></div>
                            </div>
                            <span class="text-[10px] font-bold text-gray-400 uppercase">@Umbraco.GetDictionaryValue("VCard.ScanVCard")</span>
                        </div>
                        <div class="flex flex-col gap-4">
                            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed italic">@Umbraco.GetDictionaryValue("VCard.Instruction")</p>
                            <button onclick="downloadVCard()"
                                class="w-full flex items-center justify-center gap-3 px-6 py-4 text-sm font-black uppercase tracking-wider bg-gradient-to-r from-vtl-orange to-vtl-teal text-primary rounded-2xl shadow-lg hover:shadow-vtl-orange/25 hover:text-secondary active:scale-95 transition-all duration-300">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2.5"><path d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
                                @Umbraco.GetDictionaryValue("VCard.SaveButton")
                            </button>    
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/qr-code-styling@1.6.0/lib/qr-code-styling.js"></script>
<script>
    // Nhận vCard đã build sẵn từ Server, dùng Json.Serialize để an toàn ký tự đặc biệt
    const vCardData = @Html.Raw(Json.Serialize(vCardContent));
    const vCardFileName = @Html.Raw(Json.Serialize(fileNameVcf));

    function downloadVCard() {
        const blob = new Blob([vCardData], { type: "text/vcard;charset=utf-8" });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = vCardFileName;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 100);
    }

    const qrCode = new QRCodeStyling({
        width: 180,
        height: 180,
        type: "svg",
        data: vCardData,
        dotsOptions: { color: "#1e293b", type: "rounded" },
        cornersSquareOptions: { type: "extra-rounded", color: "#e06800" },
        cornersDotOptions: { type: "dot", color: "#006351" },
        backgroundOptions: { color: "#f8fafc" },
        image: "/umbraco/assets/VTL_logo_square.svg",
        imageOptions: { crossOrigin: "anonymous", margin: 1, imageSize: 0.35 }
    });

    qrCode.append(document.getElementById("qr-vcard"));
</script>
